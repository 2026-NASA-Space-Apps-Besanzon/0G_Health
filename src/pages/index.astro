---
import Base from '../layouts/Base.astro';
import { SENSORS, TAGS } from '../data/sensors';
import { story } from '../lib/sim';
const S = story();
const HRP = 'https://www.nasa.gov/hrp/hazards/';
---
<Base>
  <div class="counter" aria-hidden="true">00 / 10</div>
  <div class="ruler" aria-hidden="true"></div>

  <section class="ch in" id="c00" data-ch="c00" style="--len:1.6">
    <div class="ch__pin">
      <div class="stage stage--bleed"></div>
      <div class="ch__head">
        <p class="label rv">Team 0G Health · NASA Space Apps 2026 · Astronaut health self-check</p>
        <h1 class="h rv d1" style="margin-top:18px">Nobody notices a&nbsp;slow change.</h1>
        <p class="sub rv d2">Baseline learns each astronaut's normal from a headpiece they sleep in, asks for two minutes each morning, and flags slow drift weeks before a medical limit.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="c01" data-ch="c01" style="--len:3">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h rv">On Mars, the doctor is up to twenty minutes away. Each&nbsp;way.</h2>
      </div>
      <div class="stage"></div>
      <p class="src">Delay figure: <a href={HRP} target="_blank" rel="noopener">NASA Human Research Program, 5 hazards</a></p>
    </div>
  </section>

  <section class="ch" id="c02" data-ch="c02" style="--len:3">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h rv">The dangerous changes are the slow&nbsp;ones.</h2>
        <p class="sub rv d1">One reading through one day. Keep scrolling: today always looks like yesterday.</p>
      </div>
      <div class="stage"></div>
      <p class="src">Illustration, not data</p>
    </div>
  </section>

  <section class="ch" id="c03" data-ch="c03" style="--len:4.5">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h rv">Medical limits are built for everyone. Drift is&nbsp;personal.</h2>
        <p class="sub rv d1">For the first fourteen days it only listens and learns your normal. After that, it notices changes a medical limit never&nbsp;would.</p>
      </div>
      <div class="stage"></div>
      <p class="src">Illustration, not data</p>
    </div>
  </section>

  <section class="ch" id="c04" data-ch="c04" style="--len:5">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h h--two rv"><span data-on="flag">Flagged on day&nbsp;{S.flagDay}.</span> <span data-on="limit">The limit was day&nbsp;{S.limitDay}.</span></h2>
      </div>
      <div class="stage">
        <input class="sr" type="range" min="1" max="150" value="1" aria-label="Mission day" />
      </div>
      <p class="src">Simulated scenario · one crew member's sleep</p>
    </div>
  </section>


  <section class="ch" id="c05" data-ch="c05" style="--len:6">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h rv">Sleep in it. Two minutes when you&nbsp;wake.</h2>
        <p class="sub rv d1">A soft headpiece records the night and your workout. The cap comes out only for&nbsp;spacewalks.</p>
        <div class="chips rv d2" style="margin-top:18px">
          <button class="chip" data-mode="day" aria-pressed="true">Ordinary day</button>
          <button class="chip" data-mode="eva" aria-pressed="false">Spacewalk day</button>
        </div>
      </div>
      <div class="stage day">
        <div class="mc panel" aria-hidden="true">
          <div class="mc__top">
            <svg viewBox="0 0 44 44" width="44" height="44" aria-hidden="true">
              <circle cx="22" cy="22" r="18" class="s-hair" stroke-width="3" />
              <circle class="mc__ring s-you" cx="22" cy="22" r="18" stroke-width="3" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 22 22)" />
            </svg>
            <div><div class="mono mc__time">0:00</div><div class="label">Morning check · day 104</div></div>
          </div>
          <ol class="mc__steps label">
            <li data-step class="on"><b>01</b> Sit</li>
            <li data-step><b>02</b> Check</li>
            <li data-step><b>03</b> Act</li>
          </ol>
          <p class="mc__hint">Headpiece still on from the night. Sit still for a minute while it takes your resting&nbsp;pulse.</p>
          <div class="mc__rows">
            <div class="mc__row"><i class="dot dot--drift"></i><span>Sleep <small>· overnight</small></span><b class="mono">6.4 h</b></div>
            <div class="mc__row"><i class="dot dot--ok"></i><span>Resting pulse</span><b class="mono">54 bpm</b></div>
            <div class="mc__row"><i class="dot dot--ok"></i><span>Heart-rhythm variability</span><b class="mono">66 ms</b></div>
            <div class="mc__row"><i class="dot dot--ok"></i><span>Skin temperature</span><b class="mono">34.6 °C</b></div>
          </div>
          <div class="mc__act">
            <p class="mc__say">Sleep has drifted for 9&nbsp;nights.</p>
            <p class="mc__do">Tonight: dim the lights 30 minutes earlier.</p>
            <div class="mc__ladder label"><span class="on">You</span><i></i><span>Crew medical officer</span><i></i><span>Flight surgeon</span></div>
          </div>
        </div>
      </div>
      <p class="src">Simulated readings · scroll to move through the day</p>
    </div>
  </section>
  <section class="ch" id="cap" data-ch="c06" style="--len:8">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h rv">One cap, six&nbsp;sensors.</h2>
        <p class="sub rv d1">Built into the lining of the comms cap astronauts already wear.</p>
      </div>
      <div class="stage">
        <nav class="rail" aria-label="Sensors">
          {SENSORS.map((s) => <button data-id={s.id} aria-current="false"><span class="label">{s.no}</span><b>{s.short === 'Temp' ? 'Skin temp' : s.short}</b></button>)}
        </nav>
        <div class="sds" aria-live="polite">
          {SENSORS.map((s, i) => (
            <article class="sd" data-id={s.id}>
              <p class="label sd__no"><span>{s.no} · {s.grams ? `${s.grams} g est.` : 'Existing part'}{s.future ? ' · Future' : ''}</span><span>{i + 1} / 6</span></p>
              <h3>{s.name}</h3>
              <dl>
                <div><dt class="label">Does</dt><dd>{s.job}</dd></div>
                <div class="sd__sits"><dt class="label">Sits</dt><dd>{s.sits}</dd></div>
                <div><dt class="label">Watches</dt><dd class="sd__w">{s.watches}</dd></div>
                <div><dt class="label">Becomes</dt><dd>
                  <ul>{s.shows.map((r) => <li><span>{r.label}</span><span class="mono sd__v">{r.value}<small> {r.unit}</small></span><span class={`tag tag--${r.tag}`}>{TAGS[r.tag]}</span></li>)}</ul>
                </dd></div>
                <div><dt class="label">Cannot</dt><dd class="sd__lim">{s.limit}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
      <p class="src">Weights are design estimates · values simulated</p>
    </div>
  </section>

  <section class="ch" id="c12" data-ch="c12" style="--len:5">
    <div class="ch__pin">
      <div class="ch__head split">
        <div>
          <h2 class="h rv">On a spacewalk, three&nbsp;numbers.</h2>
          <p class="sub rv d1">Heat, workload and oxygen. When one leaves your normal, the alert climbs a chain, nearest person first, because Earth is twenty minutes&nbsp;away.</p>
        </div>
        <div class="chain rv d2">
          <p class="label chain__t">Who hears, and when</p>
          <ol>
            <li><i></i><b>You</b><span>Your watch taps twice. You act first.</span></li>
            <li><i></i><b>Partner</b><span>Told next, an arm's length away.</span></li>
            <li><i></i><b>Habitat</b><span>The crew inside can talk you back to the airlock.</span></li>
            <li><i></i><b>Earth</b><span>Hears last. The message takes up to 20&nbsp;minutes.</span></li>
          </ol>
          <p class="chain__msg label" aria-live="polite">All three inside your normal</p>
        </div>
      </div>
      <div class="stage"></div>
    </div>
  </section>

  <section class="ch" id="c13" data-ch="c13" style="--len:2">
    <div class="ch__pin">
      <div class="ch__head">
        <h2 class="h rv">Raw brainwaves never leave the&nbsp;ship.</h2>
        <p class="sub rv d1">Voice works the same way: opt-in, analysed on the device, never recorded.</p>
      </div>
      <div class="stage"></div>
    </div>
  </section>

  <section class="ch" id="c14" data-ch="c14" style="--len:2.4">
    <div class="ch__pin">
      <div class="ch__head split">
        <div>
          <h2 class="h rv">What it cannot sense,&nbsp;yet.</h2>
          <p class="sub rv d1">Three of the biggest long-term risks are out of the cap's reach. Here is how the tool tracks them today, and the algorithms we are building to do&nbsp;better.</p>
        </div>
        <div class="say rv d2">
          <p class="label say__t">Every number says where it came from</p>
          <dl>
          <div><dt><span class="tag tag--sensed">{TAGS.sensed}</span></dt><dd>A sensor measured it directly.</dd></div>
          <div><dt><span class="tag tag--ml">{TAGS.ml}</span></dt><dd>A model's best guess, with how sure it is.</dd></div>
          <div><dt><span class="tag tag--you">{TAGS.you}</span></dt><dd>Measured with a quick test, not a sensor. The tool keeps the record.</dd></div>
          <div><dt><span class="tag tag--ship">{TAGS.ship}</span></dt><dd>Read from the spacecraft's own instruments.</dd></div>
          </dl>
        </div>
      </div>
      <div class="next">
        <article class="rv d1">
          <h3>Bone and muscle loss</h3>
          <div class="next__row"><span class="label">Today</span><p>You log each workout. Bone density is scanned before and after the mission.</p><span class="tag tag--you">{TAGS.you}</span></div>
          <div class="next__row next__row--next"><span class="label">Next</span><p>An algorithm that turns the headpiece's motion and pulse during your workout into a daily loading score, so a week of light sessions shows up as drift.</p><span class="tag tag--next">In development</span></div>
        </article>
        <article class="rv d2">
          <h3>Vision change</h3>
          <div class="next__row"><span class="label">Today</span><p>A weekly eye chart on the tablet, each eye.</p><span class="tag tag--you">{TAGS.you}</span></div>
          <div class="next__row next__row--next"><span class="label">Next</span><p>A contrast and distortion test that compares each eye with its own first weeks in flight, to catch the slow vision changes seen on long missions.</p><span class="tag tag--next">In development</span></div>
        </article>
        <article class="rv d3">
          <h3>Radiation</h3>
          <div class="next__row"><span class="label">Today</span><p>Read from the ship's dosimeter, kept as your running total.</p><span class="tag tag--ship">{TAGS.ship}</span></div>
          <div class="next__row next__row--next"><span class="label">Next</span><p>Solar-storm mode: when the dosimeter spikes, the shelter checklist opens, and sleep and recovery are watched closely for the days after.</p><span class="tag tag--next">In development</span></div>
        </article>
      </div>
    </div>
  </section>

  <section class="ch" id="c15" data-ch="c15">
    <div class="ch__pin">
      <div class="stage stage--bleed"></div>
      <div class="ch__head end">
        <h2 class="h rv">Run your own morning&nbsp;check.</h2>
        <p class="sub rv d1">Watch one simulated crew member fly 180 days to Mars, and see what the tool tells them along the way.</p>
        <p class="rv d2 end__cta"><a class="btn" href="/app">Open the tool <span aria-hidden="true">→</span></a></p>
      </div>
      <footer class="foot label">
        <span>Baseline by team 0G Health · NASA Space Apps Challenge 2026 · Health monitoring software</span>
        <span>A prototype. All data simulated. Not a medical device.</span>
      </footer>
    </div>
  </section>

  <script>
    import { chrome } from '../lib/motion';
    import * as A from '../story/a';
    import * as B from '../story/b';
    import * as C from '../story/c';
    const all: Record<string, (s: HTMLElement) => void> = { ...A, ...B, ...C };
    document.querySelectorAll<HTMLElement>('[data-ch]').forEach((s) => all[s.dataset.ch!]?.(s));
    chrome();
  </script>
</Base>

<style>

  /* 05 · the day: clock + morning check */
  .day { touch-action: pan-y; }
  .mc { position: absolute; z-index: 3; right: 0; top: 0; width: min(380px, 40%); padding: 22px; display: grid; gap: 16px; opacity: 0; pointer-events: none; will-change: opacity, transform; }
  .mc__top { display: flex; gap: 14px; align-items: center; }
  .mc__time { font-size: 28px; line-height: 1; margin-bottom: 4px; }
  .mc__steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .mc__steps li { white-space: nowrap; padding-top: 8px; border-top: 2px solid var(--line); color: var(--mute); transition: color 0.3s, border-color 0.3s; }
  .mc__steps li b { font-weight: 400; color: inherit; margin-right: 4px; }
  .mc__steps li.on { color: var(--bone); border-color: var(--you); }
  .mc__steps li.done { border-color: var(--mute); }
  .mc__hint { font-size: 15px; color: var(--mute); line-height: 1.4; transition: opacity 0.3s; }
  .mc__hint.off { opacity: 0; height: 0; margin-top: -16px; overflow: hidden; }
  .mc__rows { display: grid; }
  .mc__row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; opacity: 0; transform: translateX(-10px); transition: opacity 0.3s, transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .mc__row small { color: var(--mute); font-size: 13px; }
  .mc__row b { margin-left: auto; font-weight: 400; }
  .mc__row.on { opacity: 1; transform: none; }
  .mc__act { border-top: 1px solid var(--line); padding-top: 14px; opacity: 0; transform: translateY(10px) scale(0.98); transition: opacity 0.3s, transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .mc__act.on { opacity: 1; transform: none; }
  .mc__say { font-size: 21px; font-weight: 600; line-height: 1.2; color: var(--drift); }
  .mc__do { margin-top: 6px; font-size: 16px; }
  .mc__ladder { display: flex; align-items: center; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .mc__ladder i { width: 14px; height: 1px; background: var(--mute); }
  .mc__ladder .on { color: var(--bone); }
  @media (max-width: 900px) { .mc { width: min(340px, 46%); padding: 18px; gap: 12px; } .mc__hint { font-size: 14px; } }
  @media (max-height: 880px) and (min-width: 641px) {
    .mc { padding: 16px 18px; gap: 10px; }
    .mc__time { font-size: 24px; } .mc__top svg { width: 36px; height: 36px; }
    .mc__hint { font-size: 13.5px; }
    .mc__row { padding: 6px 0; font-size: 14px; }
    .mc__act { padding-top: 10px; }
    .mc__say { font-size: 18px; } .mc__do { font-size: 14.5px; } .mc__ladder { margin-top: 8px; font-size: 10px; }
  }
  @media (max-height: 740px) and (min-width: 641px) { .mc__hint, .mc__row:nth-child(4) { display: none; } }
  @media (max-width: 640px) {
    .mc { top: auto; bottom: 0; left: 0; right: 0; width: auto; padding: 14px; gap: 10px; transform: none; }
    .mc__time { font-size: 22px; }
    .mc__top svg { width: 34px; height: 34px; }
    .mc__hint { display: none; }
    .mc__rows, .mc__act { grid-row: 3; grid-column: 1; }
    .mc__act { background: var(--ink-2); align-self: start; }
    .mc:has(.mc__act.on) .mc__row { opacity: 0; }
    .mc__row { padding: 6px 0; font-size: 14px; }
    .mc__row:nth-child(n+3) { display: none; }
    .mc__say { font-size: 17px; } .mc__do { font-size: 14px; } .mc__ladder { margin-top: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .mc__row, .mc__act, .mc__steps li { transition: none; } }

  /* 06 · spec sheet */
  #cap .sub { transition: opacity 0.3s; }
  #cap:global(.walk) .sub { opacity: 0; }
  .rail, .sds { opacity: 0; transition: opacity 0.35s ease; }
  #cap:global(.walk) .rail, #cap:global(.walk) .sds { opacity: 1; }
  .rail { position: absolute; z-index: 3; left: 0; top: 50%; transform: translateY(-50%); display: grid; width: 168px; padding-left: 14px; }
  .rail::before, .rail::after { content: ''; position: absolute; left: 0; top: 0; width: 1px; height: 100%; background: var(--line); }
  .rail::after { background: var(--you); width: 2px; left: -0.5px; transform-origin: top; transform: scaleY(var(--prog, 0)); transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.15); }
  .rail button { display: grid; grid-template-columns: 44px 1fr; align-items: baseline; text-align: left; padding: 11px 0; color: var(--mute); transition: color 0.2s, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .rail button b { font-weight: 500; font-size: 17px; }
  .rail button .label { color: inherit; }
  .rail button:hover { color: var(--bone); }
  .rail button[aria-current='true'] { color: var(--bone); transform: translateX(6px); }
  .rail button[aria-current='true'] .label { color: var(--you); }
  .sds { position: absolute; z-index: 3; right: 0; top: 0; bottom: 0; width: min(440px, 36vw); display: grid; align-items: center; pointer-events: none; }
  .sd { grid-area: 1 / 1; display: grid; gap: clamp(8px, 1.5svh, 14px); opacity: 0; transform: translateY(16px); transition: opacity 0.2s ease, transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.25); }
  .sd.on { opacity: 1; transform: none; transition-delay: 0.08s; }
  .sd__no { display: flex; justify-content: space-between; color: var(--you); }
  .sd__no span:last-child { color: var(--mute); }
  .sd h3 { font-size: clamp(26px, 2.8vw, 40px); font-weight: 600; line-height: 1.04; letter-spacing: -0.02em; }
  .sd dl { display: grid; border-top: 1px solid var(--line); }
  .sd dl > div { display: grid; grid-template-columns: 82px 1fr; gap: 10px; padding: clamp(7px, 1.3svh, 12px) 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .sd dd { margin: 0; font-size: 15.5px; line-height: 1.35; color: var(--bone); }
  .sd__w { color: var(--you) !important; font-weight: 600; font-size: 17px !important; }
  .sd__lim { color: var(--mute) !important; }
  .sd ul { list-style: none; padding: 0; display: grid; gap: 7px; }
  .sd li { display: grid; grid-template-columns: 1fr auto auto; gap: 10px; align-items: center; }
  .sd__v { color: var(--bone); } .sd__v small { color: var(--mute); font-size: 0.8em; }
  .sd .tag { font-size: 9.5px; padding: 3px 6px; }
  .sd .tag--ship { padding: 1px 5px; }
  @media (max-height: 760px) { .sd__sits { display: none !important; } }
  @media (max-width: 900px) {
    .rail { top: auto; bottom: 0; left: 0; right: 0; transform: none; width: auto; padding: 0; grid-template-columns: repeat(6, 1fr); gap: 4px; }
    .rail::before, .rail::after { display: none; }
    .rail button { grid-template-columns: 1fr; padding: 8px 0; text-align: center; border: 1px solid var(--line); border-radius: 2px; }
    .rail button b { display: none; }
    .rail button[aria-current='true'] { transform: none; border-color: var(--bone); }
    .sds { left: 0; width: auto; top: 41%; bottom: 46px; align-items: start; }
    .sd h3 { font-size: 22px; } .sd { gap: 6px; }
    .sd dl > div { grid-template-columns: 68px 1fr; padding: 5px 0; } .sd dd { font-size: 14px; }
    .sd__sits { display: none !important; } .sd .tag { display: none; }
    .sd li { grid-template-columns: 1fr auto; }
  }
  @media (prefers-reduced-motion: reduce) { .sd, .rail, .sds, .rail button, .rail::after { transition: none; } }

  /* 12 · the alert chain beside the title (.split is shared with 14) */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 420px); gap: 20px clamp(24px, 4vw, 64px); align-items: start; }
  .chain ol { list-style: none; padding: 0; margin-top: 12px; display: grid; position: relative; }
  .chain ol::before { content: ''; position: absolute; left: 7px; top: var(--a0, 12px); height: var(--span, 0); width: 1px; background: repeating-linear-gradient(var(--line) 0 3px, transparent 3px 7px); }
  .chain ol::after { content: ''; position: absolute; left: 6.75px; top: var(--a0, 12px); width: 1.5px; height: var(--fill, 0); background: var(--drift); }
  .chain li { position: relative; display: grid; grid-template-columns: 30px auto; column-gap: 4px; padding: 7px 0; color: var(--mute); transition: color 0.3s; }
  .chain li i { grid-row: span 2; position: relative; z-index: 1; width: 15px; height: 15px; margin-top: 3px; border-radius: 50%; border: 1.5px solid var(--line); background: var(--ink); transition: border-color 0.15s, transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.6); }
  .chain li b { font-weight: 600; font-size: 19px; line-height: 1.2; }
  .chain li span { font-size: 14px; line-height: 1.35; }
  .chain li.on { color: var(--bone); }
  .chain li.on i { border-color: var(--drift); background: radial-gradient(circle, var(--drift) 0 3px, var(--ink) 3.5px); }
  .chain li.on b { color: var(--drift); }
  .chain li.now i { transform: scale(1.25); }
  .chain li.now.buzz i { animation: buzz 1.4s infinite; }
  @keyframes buzz { 0%, 6%, 14%, 20% { translate: 0 0; } 2%, 16% { translate: -1.5px 0; } 4%, 18% { translate: 1.5px 0; } 21%, 100% { translate: 0 0; } }
  .chain__msg { margin-top: 10px; color: var(--you); min-height: 1.4em; }
  .chain[data-hot] .chain__msg { color: var(--drift); }
  @media (max-width: 1000px) {
    .split { grid-template-columns: 1fr; gap: 12px; }
    .chain ol { grid-template-columns: repeat(4, 1fr); margin-top: 8px; }
    .chain ol::before, .chain ol::after { left: var(--a0, 7px); top: 7px; height: 1px; }
    .chain ol::before { width: var(--span, 0); background: repeating-linear-gradient(90deg, var(--line) 0 3px, transparent 3px 7px); }
    .chain ol::after { height: 1.5px; width: var(--fill, 0); }
    .chain li { grid-template-columns: 1fr; padding: 0; row-gap: 6px; }
    .chain li i { margin: 0; }
    .chain li b { font-size: 15px; }
    .chain li span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .chain li, .chain li i { transition: none; } .chain li.now.buzz i { animation: none; } }

  /* 14 · today and next */
